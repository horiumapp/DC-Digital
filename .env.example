# ⚠️ SEGURANÇA: Nunca prefixe chaves secretas (API keys, tokens) com VITE_.
# Variáveis VITE_* são embutidas no bundle JavaScript público!

# URL da aplicação
APP_URL=http://localhost:3000

# URL pública do projeto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave anon pública do Supabase (Project Settings > API)
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# (Opcional) DSN do Sentry para monitoramento de erros em produção
# Criar conta gratuita em https://sentry.io → Settings → Projects → DSN
# Sem esta variável, o monitoramento de erros está desativado.
VITE_SENTRY_DSN=
