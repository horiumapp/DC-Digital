# ============================================================
# DC Digital — Exemplo de Variáveis de Ambiente
# ============================================================
# ⚠️  NUNCA commite o arquivo .env com valores reais!
#     Copie este arquivo para .env e preencha com seus valores.
#
# ⚠️  Se o .env real foi exposto (repositório público, OneDrive,
#     Google Drive ou qualquer serviço de sincronização), rotacione
#     imediatamente as chaves:
#     - ANON_KEY: Supabase Dashboard → Settings → API → Regenerate
#     - SENTRY_DSN: Sentry → Settings → Projects → Client Keys → Revogar
#
# Em produção (Vercel), configure as variáveis pelo painel:
#   Vercel → Project → Settings → Environment Variables
#   (nunca faça upload do .env para o servidor)
# ============================================================

# ⚠️ SEGURANÇA: Nunca prefixe chaves secretas (API keys, tokens) com VITE_.
# Variáveis VITE_* são embutidas no bundle JavaScript público!

# URL da aplicação
APP_URL=http://localhost:3000

# URL pública do projeto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave anon pública do Supabase (Project Settings > API)
# É seguro expor no frontend — controle o acesso via RLS nas tabelas!
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# (Opcional) DSN do Sentry para monitoramento de erros em produção
# Criar conta gratuita em https://sentry.io → Settings → Projects → DSN
# Sem esta variável, o monitoramento de erros está desativado.
VITE_SENTRY_DSN=
