# ============================================================
# DC Digital — Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com valores reais no repositório.
# ============================================================

# Chave da API Google Gemini (opcional, se usar IA)
GEMINI_API_KEY="SUA_GEMINI_API_KEY_AQUI"

# URL da aplicação hospedada
APP_URL="http://localhost:3000"

# URL pública do projeto Supabase (encontrada em Project Settings > API)
VITE_SUPABASE_URL=https://iaeisumzwxhwioufgliu.supabase.co

# Chave anon pública do Supabase (encontrada em Project Settings > API)
# É seguro expor no frontend — controle o acesso via RLS nas tabelas!
VITE_SUPABASE_ANON_KEY=***REMOVED_ANON_KEY***
